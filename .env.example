# Copy this file to .env and fill in your Supabase values. Never commit .env.
# Supabase dashboard -> Connect -> ORMs -> Prisma shows both strings.

# App runtime: transaction pooler (port 6543).
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma CLI / migrations: direct or session connection (port 5432).
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Better Auth: secret signs session cookies (generate with `npx @better-auth/cli secret`
# or `openssl rand -base64 32`); URL is the app's base URL.
BETTER_AUTH_SECRET="replace-with-a-random-32+-char-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Google sign-in (optional: leave empty to turn it off). Create an OAuth client
# ID of type "Web application" in Google Cloud Console -> APIs & Services ->
# Credentials, with this authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (optional in development). Password-reset links are sent through
# Resend (https://resend.com, free tier) when both are set. Create an API key
# under API Keys, and verify your sending domain under Domains: until a domain
# is verified Resend only delivers to your own Resend account's address.
# Without these, development prints each email (reset link included) to the
# `npm run dev` console, and production sends nothing and logs an error.
RESEND_API_KEY=""
EMAIL_FROM="AntiLonely <no-reply@your-verified-domain.example>"
